# 统一换行：仓库内一律 LF，Windows 检出也保持一致，避免无意义的整文件 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary

# Dockerfile / shell 脚本
Dockerfile text eol=lf
*.sh text eol=lf
Caddyfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
