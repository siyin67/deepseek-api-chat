# ---------------------------------------------------------------------------
# 复制为 deploy/.env 后按需修改：cp .env.example .env
# 所有变量都会被 docker-compose.yml 读取并注入容器。
# ---------------------------------------------------------------------------

# --- 访问入口 / 反向代理 ------------------------------------------------------
# 应用容器只把端口映射到宿主机回环（127.0.0.1），由宿主机上的 Nginx 反代到它。
# 宿主机 Nginx 配置见 deploy/nginx.conf。
# 改端口时记得同步改 nginx.conf 里 upstream 的 server 行。
APP_PORT=3000

# 可选：让 compose 自带一个 Caddy 容器来终止 HTTPS（不想在宿主机装 Nginx 时用）
# 留空 = 不启动任何代理容器（默认，配合宿主机 Nginx）
# caddy = 启动 Caddy（需同时把下面 SITE_ADDRESS 填成域名）
COMPOSE_PROFILES=

# 以下仅 caddy 模式有效：填域名（chat.example.com）时自动申请 Let's Encrypt 证书并启用 HTTPS；
# 首次试跑或内网可用 :80 只开 HTTP。
SITE_ADDRESS=:80

# --- 数据库 -----------------------------------------------------------------
POSTGRES_DB=deepseekchat
POSTGRES_USER=deepseekchat
# 必填：请换成随机强密码
POSTGRES_PASSWORD=change-me-postgres
# 连接池上限
DATABASE_POOL_SIZE=10
# 仅供本地开发（`cd server && npm run dev` 会读取本文件）：
# 容器内由 docker-compose.yml 自动拼接，无需在此填写。
# DATABASE_URL=postgres://deepseekchat:change-me-postgres@127.0.0.1:5432/deepseekchat

# --- 模型 Key 加密主密钥（必填） --------------------------------------------
# 必须是 32 字节，base64 或 64 位 hex。生成方式：
#   openssl rand -base64 32
# 该密钥只存在于服务端，用来以 AES-256-GCM 加密用户保存的模型 Key；
# 更换或丢失后，已保存的 Key 无法解密（用户需要重新填写）。
APP_ENCRYPTION_KEY=

# --- 账号 -------------------------------------------------------------------
# 首次部署建议保持 true 注册自己的账号，随后改成 false 关闭注册
ALLOW_REGISTRATION=true
# 登录凭证有效期（天）
AUTH_TOKEN_TTL_DAYS=30

# --- 模型 API ---------------------------------------------------------------
# 可选：服务端兜底 Key。留空时每个用户必须在「设置 → 数据管理」里填写自己的 Key。
# 无论哪种方式，浏览器只能看到掩码，拿不到明文。
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
# 单轮模型请求的超时（毫秒），长回答需要较长时间
UPSTREAM_TIMEOUT_MS=600000

# --- 上下文与分页 -----------------------------------------------------------
# 发送前按 token 预算裁剪历史（超出部分整轮丢弃最早的内容）
CONTEXT_TOKEN_BUDGET=120000
# 会话元数据每页条数、会话消息每页条数（懒加载的分页粒度）
SESSION_PAGE_SIZE=30
MESSAGE_PAGE_SIZE=30
# 单个附件上传上限（MB）
MAX_UPLOAD_MB=64

# --- 其他 -------------------------------------------------------------------
# 对外访问地址（如 https://chat.example.com），留空表示同源
PUBLIC_ORIGIN=
# debug / info / warn / error
LOG_LEVEL=info
