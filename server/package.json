{
  "name": "deepseek-api-chat-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "deepseek-api-chat 的服务端：账号、会话持久化、模型请求转发。",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --watch --env-file-if-exists=../deploy/.env src/index.ts"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@fastify/multipart": "9.0.3",
    "@fastify/static": "8.1.1",
    "fastify": "5.2.1",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "@types/pg": "8.11.11",
    "typescript": "5.7.3"
  }
}
